{
  "version": 2,
  "functions": {
    "api/rekognition.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/api/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "crons": [
    {
      "path": "/api/payout-worker",
      "schedule": "0 0 * * *"
    }
  ]
}